JWT_SECRET=dev_secret_change_in_production
MQTT_SERVICE_PASSWORD=dev_service_mqtt_secret
MQTT_FRIGATE_PASSWORD=dev_frigate_mqtt_secret
MQTT_TOPIC_PREFIX=t
PUBLIC_MQTT_HOST=localhost
PUBLIC_MQTT_PORT=1884
TUNNEL_INTERNAL_KEY=dev_tunnel_internal_key

# Frigate
FRIGATE_CONFIG_PATH=/frigate_config/config.yml
FRIGATE_API_URL=http://host.docker.internal:5000

# FCM (push bildirim)
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/app/fcm/service-account.json
