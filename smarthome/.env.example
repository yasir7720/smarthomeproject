# N8N Konfigürasyonu
N8N_ENCRYPTION_KEY=change_this_to_a_long_random_key
N8N_HOST=localhost
N8N_PROTOCOL=http

# MQTT Haberleşmesi (Docker Network)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smarthome

# Tailscale IP'leri (Opsiyonel: Dış ağdan erişim için)
# MOSQUITTO_TAILSCALE_IP=100.x.x.x
# FRIGATE_TAILSCALE_IP=100.x.x.x
# N8N_TAILSCALE_IP=100.x.x.x
